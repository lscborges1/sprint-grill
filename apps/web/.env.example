# Personal Access Token do Azure DevOps (escopos de leitura e escrita de work items).
# Segredo: nunca vai para o arquivo de config nem para o log.
AZURE_DEVOPS_PAT=

# trace | debug | info | warn | error | fatal — padrão: info
LOG_LEVEL=info

# Estado de cerimônia (SQLite). Padrão: .sprint-griller/cerimonias.db ao lado da
# config da squad. Apagar o arquivo só perde cerimônias em andamento.
SPRINT_GRILLER_DB=

# Demo local com fixtures em /dev-ui, sem Azure DevOps/Codex/config da squad.
# Use via `pnpm demo`, não no fluxo conectado.
REFINA_DEMO=
